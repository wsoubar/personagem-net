{
  "name": "personagens",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "lint": "eslint src/app --max-warnings=0",
    "emulators": "firebase emulators:start --project demo-personagens --only auth,firestore",
    "test:rules": "firebase emulators:exec --project demo-personagens --only auth,firestore \"node --test tests/firestore.rules.test.mjs\"",
    "e2e": "firebase emulators:exec --project demo-personagens --only auth,firestore \"playwright test\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "bootstrap": "5.3.9",
    "firebase": "13.3.0",
    "font-awesome": "4.7.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@angular/language-service": "22.2.6",
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "eslint": "10.15.0",
    "firebase-tools": "15.36.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^24.15.0",
    "npm": ">=10"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "glob": "14.0.6",
    "uuid": "11.1.1",
    "@opentelemetry/core": "2.10.0"
  }
}
